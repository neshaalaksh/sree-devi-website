---
layout: layouts/base.njk
pageClass: home
permalink: /
description: "Pregnancy and delivery, fertility treatment (IUI, IVF, ICSI) and gynaecology in Trichy since 2005. Specialists across 10 departments. Emergency care 24 hours."
seoTitle: "Sree Devi Hospital, Trichy: Maternity & Fertility Care"
---
{%- from "partials/icons.njk" import icon -%}
{%- from "partials/components.njk" import btnCall, btnWhatsApp, btnBook, faqBlock, contactBlock with context -%}
{%- set s = settings -%}
{%- set h = settings.home -%}

<section class="hero hero--home">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow eyebrow--plain">{{ h.hero_eyebrow }}</p>
      <h1 class="h-hero">{{ h.hero_title | accent | safe }}</h1>
      <p class="hero__lead">{{ h.hero_text }}</p>
      <div class="btn-row">{{ btnWhatsApp() }} {{ btnBook() }}</div>
    </div>
    <div class="hero__media">
      <img class="arch arch--tl" src="/assets/images/home-hero-building.webp" alt="Sree Devi Hospital & Fertility Centre building on Gandhi Road, Srirangam" width="960" height="1056" fetchpriority="high">
    </div>
  </div>
  <div class="container container--strip">
    <div class="info-strip">
      <div class="info-strip__item">
        <span class="info-strip__icon"><img src="/assets/images/icons/info-clock.svg" alt="" width="23" height="23"></span>
        <p class="info-strip__label">OPD Days</p>
        <p class="info-strip__value">{{ s.timings.opd_days_short }}</p>
      </div>
      <div class="info-strip__item">
        <span class="info-strip__icon"><img src="/assets/images/icons/info-heart.svg" alt="" width="23" height="21"></span>
        <p class="info-strip__label">Emergency &amp; Delivery</p>
        <p class="info-strip__value">{{ s.timings.emergency }}</p>
      </div>
      <a class="info-strip__item" href="{{ s.address.directions_url }}" target="_blank" rel="noopener">
        <span class="info-strip__icon"><img src="/assets/images/icons/info-pin.svg" alt="" width="21" height="25"></span>
        <p class="info-strip__label">Find Us</p>
        <p class="info-strip__value">{{ s.address.short }}</p>
      </a>
    </div>
  </div>
</section>

<section class="section section--sage" id="about">
  <div class="container intro">
    <div class="intro__media" aria-hidden="true">
      <img class="intro__img1" src="/assets/images/home-intro-consult.webp" alt="" loading="lazy">
      <span class="intro__dot"></span>
      <img class="intro__img2" src="/assets/images/home-intro-newborn.webp" alt="" loading="lazy">
    </div>
    <div class="intro__copy">
      <p class="eyebrow">Introduction</p>
      <h2 class="h-display h-display--lg">{{ h.intro_title | accent | safe }}</h2>
      <p>{{ h.intro_text }}</p>
      <dl class="stats">
        <div><dt>{{ s.established_year }}</dt><dd>Established</dd></div>
        <div><dt>{{ departments.items.length }}</dt><dd>Departments</dd></div>
        <div><dt>24/7</dt><dd>Emergency &amp; delivery</dd></div>
      </dl>
      <a class="btn btn--outline" href="/about/">Know More About Us {{ icon("arrow", 16) }}</a>
    </div>
  </div>
</section>

<section class="section section--cream">
  <div class="container">
    <div class="split-head">
      <h2 class="h-display h-display--lg">What we <em>offer</em></h2>
      <p>Maternity, fertility and women's health care in Trichy, with specialists in {{ departments.items.length }} departments for the whole family.</p>
    </div>
    <div class="offer-grid">
      {%- for d in home_offer.items %}
      <a class="offer-card offer-card--{{ d.colour }}" href="{{ d.link }}">
        {%- if d.image %}<img class="offer-card__photo" src="{{ d.image }}" alt="" width="205" height="300" loading="lazy">{% endif %}
        {%- if d.icon %}<span class="offer-card__icon"><img src="{{ d.icon }}" alt="" loading="lazy"></span>{% endif %}
        <h3>{{ d.name }}</h3>
        <p>{{ d.text }}</p>
        <span class="offer-card__link">{{ d.link_label }} &nbsp;→</span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--plum fertility-band">
  <div class="container container--narrow center">
    <p class="eyebrow eyebrow--peach">Fertility Centre</p>
    <h2 class="h-display h-display--md">Specialist care for your <em>fertility journey</em>.</h2>
    <p>Fertility evaluation, counselling and treatments including IUI, IVF and ICSI, with care and guidance from the hospital team.</p>
    <a class="btn btn--plum-light" href="/fertility-centre/">Explore Fertility Centre →</a>
  </div>
</section>

<section class="section section--sage doctors-cf" aria-labelledby="doctors-title">
  <div class="container">
    <div class="doctors-cf__head">
      <div class="doctors-cf__copy">
        <p class="eyebrow">Our doctors</p>
        <h2 class="h-display h-display--lg" id="doctors-title">{{ h.doctors_title | accent | safe }}</h2>
        <p>{{ h.doctors_text }}</p>
      </div>
      <a class="btn btn--outline" href="/doctors/">Meet All Doctors →</a>
    </div>

    <div class="cf" data-cf role="region" aria-roledescription="carousel" aria-label="Our doctors">
      <div class="cf__row">
        <button class="cf__arrow cf__arrow--prev" type="button" data-cf-prev aria-label="Previous doctor">{{ icon("arrow", 20, "icon--flip") }}</button>
        <ul class="cf__stage" data-cf-stage>
          {%- for doc in collections.doctors %}
          {%- set d = doc.data %}
          <li class="cf__item" data-cf-item data-name="{{ d.name }}" data-dept="{{ d.department }}" data-quals="{{ d.qualifications }}" data-reg="{{ d.registration_no }}" data-href="/doctors/#{{ doc.page.fileSlug }}">
            <a class="cf__link" href="/doctors/#{{ doc.page.fileSlug }}" aria-label="{{ d.name }}, {{ d.department }}. View profile">
              {%- if d.photo %}<img src="{{ d.photo }}" alt="" width="800" height="1000" loading="lazy" decoding="async">{% else %}<span class="cf__initials" aria-hidden="true">{{ d.name | initials }}</span>{% endif %}
            </a>
            <div class="cf__meta">
              <h3>{{ d.name }}</h3>
              <p class="cf__dept">{{ d.department }}</p>
              <p>{{ d.qualifications }}</p>
              <p>TNMC Reg. No. {{ d.registration_no }}</p>
            </div>
          </li>
          {%- endfor %}
        </ul>
        <button class="cf__arrow cf__arrow--next" type="button" data-cf-next aria-label="Next doctor">{{ icon("arrow", 20) }}</button>
      </div>

      <div class="cf__caption" data-cf-caption hidden>
        <p class="cf__cap-name" data-cf-name></p>
        <span class="cf__chip" data-cf-dept></span>
        <p class="cf__cap-quals" data-cf-quals></p>
        <p class="cf__cap-reg">TNMC Reg. No. <span data-cf-reg></span></p>
        <a class="link-arrow" href="/doctors/" data-cf-link>View profile {{ icon("arrow", 16) }}</a>
      </div>

      <div class="cf__dots" data-cf-dots hidden>
        {%- for doc in collections.doctors %}
        <button type="button" data-cf-dot aria-label="Show {{ doc.data.name }}"><span></span></button>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>

<section class="section section--cream" id="facilities">
  <div class="container">
    <div class="split-head split-head--center">
      <h2 class="h-display h-display--lg">Our <em>Facilities</em></h2>
      <a class="link-arrow" href="/facilities/">Explore Our Facilities {{ icon("arrow", 16) }}</a>
    </div>
    {%- set feat = facilities.items | where("featured", true) | limit(4) %}
    <div class="fac-grid">
      {%- for f in feat %}
      <figure class="fac-tile fac-tile--{{ loop.index }}">
        {%- if f.image %}<img src="{{ f.image }}" alt="{{ f.title }}" loading="lazy">{% else %}<div class="fac-tile__ph" aria-hidden="true"></div>{% endif %}
        <figcaption>{{ f.title }}</figcaption>
      </figure>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--peach">
  <div class="container">
    <div class="center">
      <p class="eyebrow">Your first visit</p>
      <h2 class="h-display h-display--md">What to <em>expect</em></h2>
    </div>
    <ol class="expect">
      <li><span class="num">1</span><h3>Before You Visit</h3><p>Call the hospital or plan to walk in on OPD days ({{ s.timings.opd_days_short }}). Keep your previous reports ready.</p></li>
      <li><span class="num">2</span><h3>When You Arrive</h3><p>Register at reception. The care team will guide you to the right doctor.</p></li>
      <li><span class="num">3</span><h3>During Your Consultation</h3><p>Discuss your concerns with the doctor and understand the next steps.</p></li>
    </ol>
  </div>
</section>

{%- set hArts = collections.articles or [] %}
{%- if not hArts.length and settings.blog_preview %}{% set hArts = blogPreview.articles %}{% endif %}
{%- if hArts.length %}
{%- set hCats = [] %}{% for a in hArts %}{% if a.data.category and a.data.category not in hCats %}{% set hCats = (hCats.push(a.data.category), hCats) %}{% endif %}{% endfor %}
<section class="section section--sage hb" id="blog">
  <div class="container">
    <div class="hb__head">
      <h2 class="hb__title">From Our <em>Blog</em></h2>
      <p class="hb__sub">Helpful information for your health.</p>
    </div>
    <div class="hb__tabs" role="tablist" aria-label="Blog topics">
      <button type="button" role="tab" aria-selected="true" data-hb="all">All</button>
      {%- for c in hCats %}<button type="button" role="tab" aria-selected="false" data-hb="{{ c | slug2 }}">{{ c }}</button>{% endfor %}
    </div>
    {%- set groups = [{ key: "all", items: hArts }] %}
    {%- for c in hCats %}{% set its = [] %}{% for a in hArts %}{% if a.data.category == c %}{% set its = (its.push(a), its) %}{% endif %}{% endfor %}{% set groups = (groups.push({ key: c | slug2, items: its }), groups) %}{% endfor %}
    {%- for g in groups %}
    <div class="hb__panel" data-hb-panel="{{ g.key }}"{% if not loop.first %} hidden{% endif %}>
      {%- set f = g.items[0] %}
      <article class="hb-feat">
        <a class="hb-feat__img ph-grad ph-c0" href="{{ f.url if f.url != '#' else '/blog/' }}" aria-hidden="true" tabindex="-1">{% if f.data.cover %}<img src="{{ f.data.cover }}" alt="" loading="lazy">{% endif %}</a>
        <p class="hb__meta">{{ f.data.author or "Sree Devi Care Team" }} • {{ f.date | readableDate }}</p>
        <h3><a href="{{ f.url if f.url != '#' else '/blog/' }}">{{ f.data.title }}</a></h3>
        <p class="hb__ex">{{ f.data.excerpt }}</p>
        <a class="hb__more" href="{{ f.url if f.url != '#' else '/blog/' }}">Read more →</a>
      </article>
      {%- if g.items.length > 1 %}
      <div class="hb-side">
        {%- for b in g.items | limit(3) %}{% if not loop.first %}
        {%- if loop.index > 2 %}<hr class="hb-side__rule">{% endif %}
        <article class="hb-card">
          <a class="hb-card__img ph-grad {{ 'ph-c1' if loop.index == 2 else 'ph-c4' }}" href="{{ b.url if b.url != '#' else '/blog/' }}" aria-hidden="true" tabindex="-1">{% if b.data.cover %}<img src="{{ b.data.cover }}" alt="" loading="lazy">{% endif %}</a>
          <div>
            <p class="hb__meta">{{ b.data.author or "Sree Devi Care Team" }} • {{ b.date | readableDate }}</p>
            <h3><a href="{{ b.url if b.url != '#' else '/blog/' }}">{{ b.data.title }}</a></h3>
            <p class="hb__ex">{{ b.data.excerpt }}</p>
          </div>
        </article>
        {%- endif %}{% endfor %}
      </div>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
</section>
<script>
(function () {
  var tabs = [].slice.call(document.querySelectorAll(".hb__tabs [data-hb]"));
  var panels = [].slice.call(document.querySelectorAll("[data-hb-panel]"));
  tabs.forEach(function (t) {
    t.addEventListener("click", function () {
      tabs.forEach(function (x) { x.setAttribute("aria-selected", x === t ? "true" : "false"); });
      panels.forEach(function (p) { p.hidden = p.getAttribute("data-hb-panel") !== t.getAttribute("data-hb"); });
    });
  });
})();
</script>
{%- endif %}

{{ faqBlock(faqs.items | where("show_on", "home")) }}

{{ contactBlock() }}
